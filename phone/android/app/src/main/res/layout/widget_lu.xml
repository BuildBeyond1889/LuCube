<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/w_tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="♫ LU CUBE" android:textColor="#FFC21A" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace"/>
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Lu Cube" android:textColor="#F2F4F7" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap to open" android:textColor="#8E98A8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_lu_prev" android:background="@android:color/transparent" android:contentDescription="Back"/>
    <ImageButton android:id="@+id/w_play" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/ic_lu_play" android:background="@android:color/transparent" android:contentDescription="Play or pause"/>
    <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_lu_next" android:background="@android:color/transparent" android:contentDescription="Next"/>
</LinearLayout>
